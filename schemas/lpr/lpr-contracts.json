{
  "ts": {
    "imports": [
      { "name": "OutputCompressionMode", "from": "./editor" },
      { "name": "VideoMarkerRect", "from": "./editor" }
    ]
  },
  "runtimeCommands": {
    "scan-targets": {
      "request": "LprTargetScanRequest",
      "response": "LprTargetScanResponse"
    },
    "ai-evidence": {
      "request": "AiEvidenceRequest",
      "response": "AiEvidenceResponse"
    },
    "analyze-frame": {
      "request": "LprFrameAnalysisRequest",
      "response": "LprFrameAnalysisResponse"
    },
    "analyze-interval": {
      "request": "LprIntervalAnalysisRequest",
      "response": "LprIntervalAnalysisResponse"
    }
  },
  "externals": {
    "OutputCompressionMode": {
      "kind": "stringUnion",
      "values": ["standard", "compact"],
      "rustName": "OutputCompressionModePayload"
    },
    "VideoMarkerRect": {
      "kind": "object",
      "fields": [
        { "name": "x", "type": "number" },
        { "name": "y", "type": "number" },
        { "name": "width", "type": "number" },
        { "name": "height", "type": "number" }
      ]
    }
  },
  "definitions": [
    {
      "name": "LprWorkflowMode",
      "kind": "stringUnion",
      "targets": ["ts"],
      "values": ["idle", "range", "target", "review"]
    },
    {
      "name": "LprJobStatus",
      "kind": "stringUnion",
      "targets": ["ts", "rust"],
      "values": ["idle", "queued", "running", "completed", "failed", "cancelled", "degraded"]
    },
    {
      "name": "LprTrackingTier",
      "kind": "stringUnion",
      "values": ["full", "partial", "detection-fallback", "anchor-only", "anchor-invalid"]
    },
    {
      "name": "LprAnchorStatus",
      "kind": "stringUnion",
      "values": ["valid", "missing-selection", "outside-interval", "not-detected", "mismatched", "degraded"]
    },
    {
      "name": "LprVehicleKind",
      "kind": "stringUnion",
      "values": ["any", "vehicle", "motorcycle", "car", "truck", "bus"]
    },
    {
      "name": "LprLegibilityLevel",
      "kind": "stringUnion",
      "values": ["perfect", "good", "poor", "illegible", "unknown"]
    },
    {
      "name": "LprAnalysisProfileId",
      "kind": "alias",
      "tsType": "string",
      "rustType": "String",
      "validatorType": "string"
    },
    {
      "name": "LprRecognitionSource",
      "kind": "alias",
      "tsType": "'baseline' | 'fused' | 'legacy-vote' | 'fused-char' | `ocr:${string}` | `fused-image:${string}`",
      "rustType": "String",
      "validatorType": "string"
    },
    {
      "name": "LprDiagnostics",
      "kind": "alias",
      "tsType": "Record<string, unknown>",
      "rustType": "Value",
      "validatorType": "json"
    },
    {
      "name": "LprArtifactStage",
      "kind": "stringUnion",
      "values": ["original", "rectified", "enhanced", "restored", "temporal-restored", "working"]
    },
    {
      "name": "LprEvidenceReason",
      "kind": "stringUnion",
      "values": ["interval-start", "interval-end", "anchor", "scheduled-sample", "motion-hotspot", "high-confidence", "sharpness-peak", "temporal-burst"]
    },
    {
      "name": "LprDecisionSource",
      "kind": "stringUnion",
      "values": ["single-frame", "temporal-restored", "fused-image", "fused-char", "legacy-vote", "support-carry"]
    },
    {
      "name": "LprSampleSelection",
      "kind": "object",
      "fields": [
        { "name": "selected", "type": "boolean" },
        { "name": "priority", "type": "number" },
        { "name": "reasons", "type": "array", "items": "LprEvidenceReason" }
      ]
    },
    {
      "name": "LprTemporalSupport",
      "kind": "object",
      "fields": [
        { "name": "strategy", "type": "string" },
        { "name": "referenceTimeMs", "type": "number", "rustType": "u64" },
        { "name": "supportFrameCount", "type": "number", "rustType": "u32" },
        { "name": "supportWindowMs", "type": "number", "rustType": "u64" },
        { "name": "supportTimes", "type": "array", "items": "number" },
        { "name": "meanAlignmentScore", "type": "number" },
        { "name": "meanQualityScore", "type": "number" },
        { "name": "sourceStage", "type": "LprArtifactStage" },
        { "name": "selectedStage", "type": "LprArtifactStage" }
      ]
    },
    {
      "name": "LprOcrInput",
      "kind": "object",
      "fields": [
        { "name": "stage", "type": "LprArtifactStage" },
        { "name": "variant", "type": "string" },
        { "name": "source", "type": "LprDecisionSource" },
        { "name": "imagePath", "type": "string", "nullable": true },
        { "name": "supportFrameCount", "type": "number", "rustType": "u32" }
      ]
    },
    {
      "name": "LprDecisionTrace",
      "kind": "object",
      "fields": [
        { "name": "source", "type": "LprDecisionSource" },
        { "name": "candidateId", "type": "string", "nullable": true },
        { "name": "sampleId", "type": "string", "nullable": true },
        { "name": "frameTimeMs", "type": "number", "rustType": "u64", "nullable": true },
        { "name": "stage", "type": "LprArtifactStage", "nullable": true },
        { "name": "supportFrameCount", "type": "number", "rustType": "u32" },
        { "name": "agreementRatio", "type": "number", "nullable": true },
        { "name": "margin", "type": "number", "nullable": true }
      ]
    },
    {
      "name": "LprAnalysisOptions",
      "kind": "object",
      "rustName": "LprAnalysisOptionsPayload",
      "fields": [
        { "name": "persistArtifacts", "type": "boolean", "optional": true },
        { "name": "artifactDir", "type": "string", "optional": true, "nullable": true },
        { "name": "trackerMode", "type": "string", "optional": true },
        { "name": "fusionMode", "type": "string", "optional": true },
        { "name": "restorationMode", "type": "string", "optional": true },
        { "name": "recognizerBackend", "type": "string", "optional": true },
        { "name": "temporalEvidenceMode", "type": "string", "optional": true },
        { "name": "sequenceReviewMode", "type": "string", "optional": true },
        { "name": "enableRectification", "type": "boolean", "optional": true },
        { "name": "enableEnhancement", "type": "boolean", "optional": true },
        { "name": "enableRecognizerComparison", "type": "boolean", "optional": true },
        { "name": "debugTag", "type": "string", "optional": true, "nullable": true },
        { "name": "ocrModelNames", "type": "array", "items": "string", "optional": true },
        { "name": "maxPlateCandidates", "type": "number", "rustType": "u32", "optional": true },
        { "name": "trackerHighConfidence", "type": "number", "optional": true },
        { "name": "trackerLowConfidence", "type": "number", "optional": true },
        { "name": "maxTrackingGap", "type": "number", "rustType": "u32", "optional": true },
        { "name": "minAlignmentScore", "type": "number", "optional": true },
        { "name": "enableReliabilityGates", "type": "boolean", "optional": true },
        { "name": "minAcceptedConfidence", "type": "number", "optional": true },
        { "name": "minCandidateMargin", "type": "number", "optional": true },
        { "name": "minIntervalSupportFrames", "type": "number", "rustType": "u32", "optional": true },
        { "name": "minSequencePersistence", "type": "number", "optional": true },
        { "name": "maxSequenceGapCount", "type": "number", "rustType": "u32", "optional": true },
        { "name": "temporalWindowMs", "type": "number", "rustType": "u64", "optional": true },
        { "name": "temporalNeighborCount", "type": "number", "rustType": "u32", "optional": true },
        { "name": "maxEvidenceSampleCount", "type": "number", "rustType": "u32", "optional": true },
        { "name": "anchorBurstCount", "type": "number", "rustType": "u32", "optional": true }
      ]
    },
    {
      "name": "LprAnalysisProfileDefinition",
      "kind": "object",
      "targets": ["ts"],
      "fields": [
        { "name": "id", "type": "LprAnalysisProfileId" },
        { "name": "label", "type": "string" },
        { "name": "description", "type": "string" },
        { "name": "options", "type": "LprAnalysisOptions" }
      ]
    },
    {
      "name": "LprAnalysisProfileCatalog",
      "kind": "object",
      "targets": ["ts"],
      "fields": [
        { "name": "version", "type": "number" },
        { "name": "defaultProfileId", "type": "LprAnalysisProfileId" },
        { "name": "developerDiagnosticsOptions", "type": "LprAnalysisOptions", "optional": true, "nullable": true },
        { "name": "profiles", "type": "array", "items": "LprAnalysisProfileDefinition" }
      ]
    },
    {
      "name": "LprReviewStatus",
      "kind": "stringUnion",
      "values": ["accepted", "review-required", "no-candidate"]
    },
    {
      "name": "LprReviewState",
      "kind": "object",
      "rustName": "LprReviewStatePayload",
      "fields": [
        { "name": "status", "type": "LprReviewStatus" },
        { "name": "acceptedCandidateId", "type": "string", "nullable": true },
        { "name": "suggestedCandidateId", "type": "string", "nullable": true },
        { "name": "reasons", "type": "array", "items": "string" }
      ]
    },
    {
      "name": "LprAnalysisProvenance",
      "kind": "object",
      "rustName": "LprAnalysisProvenancePayload",
      "fields": [
        { "name": "requestId", "type": "string", "nullable": true },
        { "name": "command", "type": "string" },
        { "name": "analysisProfileId", "type": "LprAnalysisProfileId", "nullable": true },
        { "name": "developerDiagnosticsEnabled", "type": "boolean" },
        { "name": "runtimeVersion", "type": "string", "nullable": true },
        { "name": "restorationMode", "type": "string", "nullable": true, "optional": true },
        { "name": "recognizerBackend", "type": "string", "nullable": true, "optional": true },
        { "name": "temporalEvidenceMode", "type": "string", "nullable": true, "optional": true },
        { "name": "sequenceReviewMode", "type": "string", "nullable": true, "optional": true },
        { "name": "emittedAtMs", "type": "number", "rustType": "u64" }
      ]
    },
    {
      "name": "TimelineIntervalSelection",
      "kind": "object",
      "rustName": "TimelineIntervalSelectionPayload",
      "fields": [
        { "name": "startMs", "type": "number", "rustType": "u64" },
        { "name": "endMs", "type": "number", "rustType": "u64" }
      ]
    },
    {
      "name": "LprQualityMetrics",
      "kind": "object",
      "rustName": "LprQualityMetricsPayload",
      "fields": [
        { "name": "sharpness", "type": "number" },
        { "name": "contrast", "type": "number" },
        { "name": "plateArea", "type": "number" },
        { "name": "angleScore", "type": "number" },
        { "name": "occlusionScore", "type": "number" },
        { "name": "glareScore", "type": "number" },
        { "name": "legibilityScore", "type": "number" },
        { "name": "overallScore", "type": "number" },
        { "name": "legibilityLevel", "type": "LprLegibilityLevel" }
      ]
    },
    {
      "name": "LprTrackedRegion",
      "kind": "object",
      "rustName": "LprTrackedRegionPayload",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "timeMs", "type": "number", "rustType": "u64" },
        { "name": "box", "type": "VideoMarkerRect" },
        { "name": "confidence", "type": "number" },
        { "name": "className", "type": "string" },
        { "name": "diagnostics", "type": "LprDiagnostics", "optional": true, "nullable": true }
      ]
    },
    {
      "name": "LprTargetTrack",
      "kind": "object",
      "rustName": "LprTargetTrackPayload",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "className", "type": "string" },
        { "name": "label", "type": "string" },
        { "name": "confidence", "type": "number" },
        { "name": "frames", "type": "array", "items": "LprTrackedRegion" },
        { "name": "diagnostics", "type": "LprDiagnostics", "optional": true, "nullable": true }
      ]
    },
    {
      "name": "LprTargetAnchor",
      "kind": "object",
      "targets": ["ts"],
      "fields": [
        { "name": "trackId", "type": "string" },
        { "name": "className", "type": "string" },
        { "name": "timeMs", "type": "number" },
        { "name": "box", "type": "VideoMarkerRect" }
      ]
    },
    {
      "name": "LprPlateCandidate",
      "kind": "object",
      "rustName": "LprPlateCandidatePayload",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "text", "type": "string" },
        { "name": "confidence", "type": "number" },
        { "name": "source", "type": "LprRecognitionSource" },
        { "name": "frameTimeMs", "type": "number", "rustType": "u64", "nullable": true },
        { "name": "countryCode", "type": "string", "nullable": true },
        { "name": "box", "type": "VideoMarkerRect", "nullable": true },
        { "name": "quality", "type": "LprQualityMetrics", "nullable": true },
        { "name": "diagnostics", "type": "LprDiagnostics", "optional": true, "nullable": true }
      ]
    },
    {
      "name": "LprFrameSample",
      "kind": "object",
      "rustName": "LprFrameSamplePayload",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "timeMs", "type": "number", "rustType": "u64" },
        { "name": "targetBox", "type": "VideoMarkerRect", "nullable": true },
        { "name": "plateBox", "type": "VideoMarkerRect", "nullable": true },
        { "name": "quality", "type": "LprQualityMetrics", "nullable": true },
        { "name": "candidates", "type": "array", "items": "LprPlateCandidate" },
        { "name": "imagePath", "type": "string", "nullable": true },
        { "name": "selection", "type": "LprSampleSelection", "optional": true, "nullable": true },
        { "name": "ocrInput", "type": "LprOcrInput", "optional": true, "nullable": true },
        { "name": "temporalSupport", "type": "LprTemporalSupport", "optional": true, "nullable": true },
        { "name": "diagnostics", "type": "LprDiagnostics", "optional": true, "nullable": true }
      ]
    },
    {
      "name": "LprJobState",
      "kind": "object",
      "targets": ["ts"],
      "fields": [
        { "name": "status", "type": "LprJobStatus" },
        { "name": "progress", "type": "number" },
        { "name": "stage", "type": "string" },
        { "name": "detail", "type": "string" },
        { "name": "requestId", "type": "string", "nullable": true },
        { "name": "error", "type": "string", "nullable": true },
        { "name": "reasonCode", "type": "string", "nullable": true, "optional": true },
        { "name": "startedAt", "type": "string", "nullable": true },
        { "name": "updatedAt", "type": "string", "nullable": true },
        { "name": "trackingTier", "type": "LprTrackingTier", "nullable": true, "optional": true },
        { "name": "coverageRatio", "type": "number", "nullable": true, "optional": true }
      ]
    },
    {
      "name": "LprProgress",
      "kind": "object",
      "targets": ["ts", "rust"],
      "rustName": "LprProgressPayload",
      "fields": [
        { "name": "progress", "type": "number" },
        { "name": "stage", "type": "string" },
        { "name": "detail", "type": "string" },
        { "name": "done", "type": "boolean" },
        { "name": "failed", "type": "boolean" },
        { "name": "requestId", "type": "string", "nullable": true },
        { "name": "reasonCode", "type": "string", "nullable": true, "optional": true },
        { "name": "trackingTier", "type": "LprTrackingTier", "nullable": true, "optional": true },
        { "name": "coverageRatio", "type": "number", "nullable": true, "optional": true }
      ]
    },
    {
      "name": "LprTrackingSummary",
      "kind": "object",
      "fields": [
        { "name": "trackingTier", "type": "LprTrackingTier" },
        { "name": "anchorStatus", "type": "LprAnchorStatus" },
        { "name": "coverageRatio", "type": "number" },
        { "name": "trackedFrameCount", "type": "number", "rustType": "u32" },
        { "name": "requestedFrameCount", "type": "number", "rustType": "u32" },
        { "name": "degradedReason", "type": "string", "nullable": true },
        { "name": "terminatedEarly", "type": "boolean" }
      ]
    },
    {
      "name": "LprSequenceTier",
      "kind": "stringUnion",
      "values": ["stable", "drifting", "gapped", "fragmented"]
    },
    {
      "name": "LprSequenceSummary",
      "kind": "object",
      "fields": [
        { "name": "sequenceTier", "type": "LprSequenceTier" },
        { "name": "dominantText", "type": "string", "nullable": true },
        { "name": "persistenceRatio", "type": "number" },
        { "name": "supportFrameCount", "type": "number", "rustType": "u32" },
        { "name": "sampleCount", "type": "number", "rustType": "u32" },
        { "name": "supportFrameGapCount", "type": "number", "rustType": "u32" },
        { "name": "predictionSwitchCount", "type": "number", "rustType": "u32" },
        { "name": "characterConsistency", "type": "array", "items": "number" },
        { "name": "characterConsistencyMean", "type": "number" }
      ]
    },
    {
      "name": "LprResultHistoryEntry",
      "kind": "object",
      "targets": ["ts"],
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "createdAt", "type": "string" },
        { "name": "interval", "type": "TimelineIntervalSelection", "nullable": true },
        { "name": "targetTrackId", "type": "string", "nullable": true },
        { "name": "acceptedCandidateId", "type": "string", "nullable": true },
        { "name": "analysisProfileId", "type": "LprAnalysisProfileId", "nullable": true },
        { "name": "developerDiagnosticsEnabled", "type": "boolean" },
        { "name": "candidates", "type": "array", "items": "LprPlateCandidate" },
        { "name": "summary", "type": "string" }
      ]
    },
    {
      "name": "LprSessionState",
      "kind": "object",
      "targets": ["ts"],
      "fields": [
        { "name": "workflowMode", "type": "LprWorkflowMode" },
        { "name": "interval", "type": "TimelineIntervalSelection", "nullable": true },
        { "name": "selectedAnalysisProfileId", "type": "LprAnalysisProfileId" },
        { "name": "showDeveloperDiagnostics", "type": "boolean" },
        { "name": "targetVehicleKind", "type": "LprVehicleKind" },
        { "name": "useDenseSampling", "type": "boolean" },
        { "name": "countryHints", "type": "array", "items": "string" },
        { "name": "job", "type": "LprJobState" },
        { "name": "targetTracks", "type": "array", "items": "LprTargetTrack" },
        { "name": "selectedTargetTrackId", "type": "string", "nullable": true },
        { "name": "selectedTargetAnchor", "type": "LprTargetAnchor", "nullable": true },
        { "name": "analysisTrack", "type": "LprTargetTrack", "nullable": true },
        { "name": "samples", "type": "array", "items": "LprFrameSample" },
        { "name": "candidates", "type": "array", "items": "LprPlateCandidate" },
        { "name": "review", "type": "LprReviewState", "nullable": true },
        { "name": "lastAnalysisProvenance", "type": "LprAnalysisProvenance", "nullable": true },
        { "name": "decision", "type": "LprDecisionTrace", "nullable": true },
        { "name": "acceptedCandidateId", "type": "string", "nullable": true },
        { "name": "history", "type": "array", "items": "LprResultHistoryEntry" }
      ]
    },
    {
      "name": "LprRuntimeStatus",
      "kind": "object",
      "rustName": "LprRuntimeStatusPayload",
      "fields": [
        { "name": "available", "type": "boolean" },
        { "name": "pythonExecutable", "type": "string", "nullable": true },
        { "name": "runtimeScript", "type": "string", "nullable": true },
        { "name": "version", "type": "string", "nullable": true },
        { "name": "missingPackages", "type": "array", "items": "string" },
        { "name": "installedPackages", "type": "array", "items": "string" },
        { "name": "detail", "type": "string" }
      ]
    },
    {
      "name": "LprTargetScanRequest",
      "kind": "object",
      "rustName": "LprTargetScanRequestPayload",
      "fields": [
        { "name": "sourcePath", "type": "string" },
        { "name": "timeMs", "type": "number", "rustType": "u64" },
        { "name": "markerRect", "type": "VideoMarkerRect", "nullable": true },
        { "name": "targetVehicleKind", "type": "LprVehicleKind" },
        { "name": "requestId", "type": "string", "optional": true, "nullable": true }
      ]
    },
    {
      "name": "LprTargetScanResponse",
      "kind": "object",
      "rustName": "LprTargetScanResponsePayload",
      "fields": [
        { "name": "detections", "type": "array", "items": "LprTrackedRegion" },
        { "name": "runtime", "type": "LprRuntimeStatus" }
      ]
    },
    {
      "name": "LprFrameAnalysisRequest",
      "kind": "object",
      "rustName": "LprFrameAnalysisRequestPayload",
      "fields": [
        { "name": "sourcePath", "type": "string" },
        { "name": "timeMs", "type": "number", "rustType": "u64" },
        { "name": "markerRect", "type": "VideoMarkerRect", "nullable": true },
        { "name": "targetVehicleKind", "type": "LprVehicleKind" },
        { "name": "selectedTargetBox", "type": "VideoMarkerRect", "nullable": true },
        { "name": "countryHints", "type": "array", "items": "string" },
        { "name": "analysisProfileId", "type": "LprAnalysisProfileId", "optional": true, "nullable": true },
        { "name": "enableDeveloperDiagnostics", "type": "boolean", "optional": true },
        { "name": "analysisOptions", "type": "LprAnalysisOptions", "optional": true, "nullable": true },
        { "name": "requestId", "type": "string", "optional": true, "nullable": true }
      ]
    },
    {
      "name": "LprFrameAnalysisResponse",
      "kind": "object",
      "rustName": "LprFrameAnalysisResponsePayload",
      "fields": [
        { "name": "detections", "type": "array", "items": "LprTrackedRegion" },
        { "name": "sample", "type": "LprFrameSample", "nullable": true },
        { "name": "candidates", "type": "array", "items": "LprPlateCandidate" },
        { "name": "acceptedCandidateId", "type": "string", "nullable": true },
        { "name": "review", "type": "LprReviewState" },
        { "name": "provenance", "type": "LprAnalysisProvenance" },
        { "name": "decision", "type": "LprDecisionTrace", "optional": true, "nullable": true },
        { "name": "runtime", "type": "LprRuntimeStatus" },
        { "name": "jobStatus", "type": "LprJobStatus", "optional": true },
        { "name": "diagnostics", "type": "LprDiagnostics", "optional": true, "nullable": true }
      ]
    },
    {
      "name": "LprIntervalAnalysisRequest",
      "kind": "object",
      "rustName": "LprIntervalAnalysisRequestPayload",
      "fields": [
        { "name": "sourcePath", "type": "string" },
        { "name": "interval", "type": "TimelineIntervalSelection" },
        { "name": "anchorTimeMs", "type": "number", "rustType": "u64" },
        { "name": "targetVehicleKind", "type": "LprVehicleKind" },
        { "name": "selectedTargetBox", "type": "VideoMarkerRect", "nullable": true },
