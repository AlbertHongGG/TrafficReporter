{
  "name": "traffic-reporter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:lpr-contracts": "node schemas/lpr/generate-contracts.mjs",
    "check:lpr-contracts": "node schemas/lpr/generate-contracts.mjs --check",
    "dev": "npm run generate:lpr-contracts && vite",
    "build": "npm run generate:lpr-contracts && tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run generate:lpr-contracts && vitest run",
    "test:watch": "npm run generate:lpr-contracts && vitest",
    "test:vnext:frontend": "npm run generate:lpr-contracts && vitest run src/vnext/editor/application/sessionStore.test.ts src/vnext/windowing/revisionedSnapshot.test.ts src/modules/editor/application/lprProgress.test.ts",
    "test:vnext:runtime": "python -m unittest discover -s traffic-lpr-runtime/tests -p \"test_runtime*.py\"",
    "test:vnext:benchmark": "python -m unittest discover -s traffic-lpr-benchmark/tests -p \"test_runtime_protocol.py\"",
    "check:vnext": "npm run check:lpr-contracts && npm run test:vnext:frontend && cargo check --manifest-path src-tauri/Cargo.toml && npm run test:vnext:runtime && npm run test:vnext:benchmark",
    "preview": "vite preview",
    "benchmark": "powershell -ExecutionPolicy Bypass -File ./traffic-lpr-benchmark/run.ps1",
    "benchmark:test": "python -m unittest discover -s traffic-lpr-benchmark/tests -p \"test*.py\"",
    "tauri": "tauri",
    "build:exe": "tauri build --no-bundle",
    "build:installer": "tauri build",
    "build:portable": "tauri build --no-bundle && powershell -Command \"Remove-Item -Recurse -Force dist-portable -ErrorAction SilentlyContinue; New-Item -ItemType Directory dist-portable | Out-Null; Copy-Item src-tauri/target/release/traffic-reporter.exe dist-portable/; Copy-Item -Recurse src-tauri/bin dist-portable/bin\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
