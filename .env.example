# Frontend - Editor Preview
VITE_LPR_TARGET_OVERLAY_TOLERANCE_MS=360

# Runtime - AI Provider
TRAFFIC_AI_PROVIDER=ollama

# Runtime - Ollama
TRAFFIC_OLLAMA_URL=
TRAFFIC_OLLAMA_MODEL=qwen3.6:35b
TRAFFIC_OLLAMA_TIMEOUT_S=1200
TRAFFIC_OLLAMA_RETRY_ATTEMPTS=1
TRAFFIC_OLLAMA_RETRY_DELAY_S=1.0

# Runtime - AI Evidence Sampling
TRAFFIC_AI_EVIDENCE_MAX_KEYFRAMES=8
TRAFFIC_AI_EVIDENCE_COARSE_SAMPLE_EVERY_MS=4000
TRAFFIC_AI_EVIDENCE_FINE_SAMPLE_EVERY_MS=500
TRAFFIC_AI_EVIDENCE_FINE_WINDOW_PADDING_MS=2000