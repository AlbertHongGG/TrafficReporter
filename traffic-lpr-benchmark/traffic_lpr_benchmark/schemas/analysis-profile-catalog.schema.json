{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "traffic/schemas/lpr/analysis-profile-catalog.schema.json",
  "title": "Traffic LPR Analysis Profile Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaultProfileId", "profiles"],
  "properties": {
    "version": { "const": 1 },
    "defaultProfileId": { "type": "string", "minLength": 1 },
    "developerDiagnosticsOptions": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "persistArtifacts": { "type": "boolean" },
        "artifactDir": { "type": ["string", "null"] },
        "trackerMode": { "type": "string" },
        "fusionMode": { "type": "string" },
        "restorationMode": { "type": "string" },
        "recognizerBackend": { "type": "string" },
        "temporalEvidenceMode": { "type": "string" },
        "sequenceReviewMode": { "type": "string" },
        "enableRectification": { "type": "boolean" },
        "enableEnhancement": { "type": "boolean" },
        "enableRecognizerComparison": { "type": "boolean" },
        "debugTag": { "type": ["string", "null"] },
        "ocrModelNames": { "type": "array", "items": { "type": "string" } },
        "maxPlateCandidates": { "type": "integer", "minimum": 1 },
        "trackerHighConfidence": { "type": "number" },
        "trackerLowConfidence": { "type": "number" },
        "maxTrackingGap": { "type": "integer", "minimum": 1 },
        "minAlignmentScore": { "type": "number" },
        "enableReliabilityGates": { "type": "boolean" },
        "minAcceptedConfidence": { "type": "number" },
        "minCandidateMargin": { "type": "number" },
        "minIntervalSupportFrames": { "type": "integer", "minimum": 1 },
        "temporalWindowMs": { "type": "integer", "minimum": 0 },
        "temporalNeighborCount": { "type": "integer", "minimum": 0 },
        "maxEvidenceSampleCount": { "type": "integer", "minimum": 1 },
        "anchorBurstCount": { "type": "integer", "minimum": 1 },
        "minSequencePersistence": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxSequenceGapCount": { "type": "integer", "minimum": 0 }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description", "options"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "persistArtifacts": { "type": "boolean" },
              "artifactDir": { "type": ["string", "null"] },
              "trackerMode": { "type": "string" },
              "fusionMode": { "type": "string" },
              "restorationMode": { "type": "string" },
              "recognizerBackend": { "type": "string" },
              "temporalEvidenceMode": { "type": "string" },
              "sequenceReviewMode": { "type": "string" },
              "enableRectification": { "type": "boolean" },
              "enableEnhancement": { "type": "boolean" },
              "enableRecognizerComparison": { "type": "boolean" },
              "debugTag": { "type": ["string", "null"] },
              "ocrModelNames": { "type": "array", "items": { "type": "string" } },
              "maxPlateCandidates": { "type": "integer", "minimum": 1 },
              "trackerHighConfidence": { "type": "number" },
              "trackerLowConfidence": { "type": "number" },
              "maxTrackingGap": { "type": "integer", "minimum": 1 },
              "minAlignmentScore": { "type": "number" },
              "enableReliabilityGates": { "type": "boolean" },
              "minAcceptedConfidence": { "type": "number" },
              "minCandidateMargin": { "type": "number" },
              "minIntervalSupportFrames": { "type": "integer", "minimum": 1 },
              "temporalWindowMs": { "type": "integer", "minimum": 0 },
              "temporalNeighborCount": { "type": "integer", "minimum": 0 },
              "maxEvidenceSampleCount": { "type": "integer", "minimum": 1 },
              "anchorBurstCount": { "type": "integer", "minimum": 1 },
              "minSequencePersistence": { "type": "number", "minimum": 0, "maximum": 1 },
              "maxSequenceGapCount": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
